<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.puitheme.iosstatusbar"
    android:versionCode="59"
    android:versionName="1.6.1">

    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="com.android.systemui" />
    </queries>
    <application
        android:allowBackup="false"
        android:hasFragileUserData="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_c17_launcher"
        android:roundIcon="@mipmap/ic_c17_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="dev.puitheme.ModernMainActivity"
            android:exported="false" />
        <activity-alias
            android:name="dev.puitheme.MainActivity"
            android:targetActivity="dev.puitheme.ModernMainActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.puitheme.SettingsActivity"
            android:targetActivity="dev.puitheme.ModernMainActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <category android:name="android.intent.category.INFO" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="dev.puitheme.SettingsProvider"
            android:authorities="dev.puitheme.iosstatusbar.settings"
            android:directBootAware="true"
            android:exported="true"
            android:grantUriPermissions="false" />
        <provider
            android:name="dev.puitheme.DiagnosticFileProvider"
            android:authorities="dev.puitheme.iosstatusbar.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
