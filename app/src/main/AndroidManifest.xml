<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.puitheme.iosstatusbar"
    android:versionCode="29"
    android:versionName="1.14.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@drawable/ic_pui_ios_statusbar"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="dev.puitheme.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="dev.puitheme.SettingsProvider"
            android:authorities="dev.puitheme.iosstatusbar.settings"
            android:directBootAware="true"
            android:exported="true"
            android:grantUriPermissions="false" />
        <provider
            android:name="dev.puitheme.DiagnosticFileProvider"
            android:authorities="dev.puitheme.iosstatusbar.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
