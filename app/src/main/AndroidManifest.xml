<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="dev.puitheme.iosstatusbar"
    android:versionCode="59"
    android:versionName="1.6.1">

    <!-- miuix-blur is minSdk 33; the settings app only composes it on Android 13+. -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Notification targets and icon sources include non-launchable system applications. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <queries>
        <package android:name="com.android.systemui" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:hasFragileUserData="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_c17_launcher"
        android:roundIcon="@mipmap/ic_c17_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name="dev.puitheme.ModernMainActivity"
            android:theme="@style/C17LaunchTheme"
            android:exported="false" />
        <activity android:name="dev.puitheme.PerformanceWebActivity" android:exported="false" />
        <activity android:name="dev.puitheme.CustomPluginNativeSettingsActivity" android:exported="false" />
        <service android:name="dev.puitheme.CustomPluginService" android:exported="false"
            android:isolatedProcess="true" android:process=":c17_plugins" android:stopWithTask="true" />
        <!-- Root managers can open the fixed local page; this entry never starts an optimization. -->
        <activity-alias android:name="dev.puitheme.PerformanceControlActivity"
            android:targetActivity="dev.puitheme.PerformanceWebActivity" android:exported="true" />
        <service android:name="dev.puitheme.PerformanceJobService" android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name="dev.puitheme.PerformanceScheduleReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name="dev.puitheme.CustomPluginBootReceiver" android:directBootAware="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity-alias
            android:name="dev.puitheme.MainActivity"
            android:targetActivity="dev.puitheme.ModernMainActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- The launcher entry under the old name (关于 → 恢复旧名称). Exactly one of the two launcher entries is enabled. -->
        <activity-alias
            android:name="dev.puitheme.LegacyLauncher"
            android:label="@string/app_name_legacy"
            android:targetActivity="dev.puitheme.ModernMainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.puitheme.SettingsActivity"
            android:targetActivity="dev.puitheme.ModernMainActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
                <category android:name="android.intent.category.INFO" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="dev.puitheme.SettingsProvider"
            android:authorities="dev.puitheme.iosstatusbar.settings"
            android:directBootAware="true"
            android:exported="true"
            android:grantUriPermissions="false">
            <!-- Visibility only: this exact marker never exposes settings or files. -->
            <grant-uri-permission android:path="/custom-plugins/visibility" />
        </provider>
        <provider
            android:name="dev.puitheme.DiagnosticFileProvider"
            android:authorities="dev.puitheme.iosstatusbar.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider
            android:name="dev.puitheme.ConfigFileProvider"
            android:authorities="dev.puitheme.iosstatusbar.config"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
