<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="welcome_language_title">언어 선택</string>
    <string name="welcome_language_summary">언제든지 ‘정보 → 언어’에서 바꿀 수 있습니다. 일부 화면은 아직 번역 중이라 당분간 중국어로 표시됩니다.</string>
    <string name="welcome_language_follow_system">시스템 설정 따르기</string>
    <string name="welcome_language_missing">원하는 언어가 없나요? 개발자에게 연락해 번역에 참여해 주세요.</string>
    <string name="welcome_tagline">ColorOS용 상태 표시줄 및 시스템 UI 사용자 지정 모듈</string>
    <string name="welcome_hello">환영합니다</string>
    <string name="welcome_developer_label">개발자</string>
    <string name="welcome_developer_note">Coolapk에서는 konwo, 그 밖의 플랫폼에서는 AiingJie라는 이름을 씁니다. 연락처는 ‘정보’ 페이지에 있습니다.</string>
    <string name="welcome_intro_title">모듈 소개</string>
    <string name="welcome_feature_statusbar_title">상태 표시줄</string>
    <string name="welcome_feature_statusbar_body">시계, 아이콘, 네트워크 속도, 배터리 등 세밀한 조정</string>
    <string name="welcome_feature_panel_title">제어 센터와 알림</string>
    <string name="welcome_feature_panel_body">스타일, 레이아웃, 상호작용 강화</string>
    <string name="welcome_feature_plugin_title">확장 플러그인</string>
    <string name="welcome_feature_plugin_body">플러그인으로 기능을 더하고 언제든 켜거나 끌 수 있습니다</string>
    <string name="welcome_plugin_paid_badge">유료일 수 있음</string>
    <string name="welcome_requirement">Root와 LSPosed(Xposed 프레임워크)가 필요하며, 주로 ColorOS를 대상으로 합니다.</string>
    <string name="welcome_intro_safety">시스템 UI 수정에는 위험이 따릅니다. 문제가 생기면 안전 모드를 켜거나 모듈을 비활성화하세요. 중요한 데이터는 미리 백업하세요.</string>
    <string name="welcome_statement_title">이용 안내</string>
    <string name="welcome_free_title">영구 무료</string>
    <string name="welcome_free_body">이 모듈은 영구 무료입니다. 기부는 전적으로 자율이며, 기부하지 않아도 모든 기능을 사용할 수 있습니다.\n\n이 모듈, 활성화 코드 또는 이른바 ‘유료 버전’을 누구에게서도 돈을 주고 사지 마세요. 이미 돈을 냈다면 환불을 요청하고 판매자를 신고하세요.</string>
    <string name="welcome_plugin_paid_title">플러그인은 유료일 수 있습니다</string>
    <string name="welcome_plugin_paid_body">플러그인은 이 모듈과 별개이며 개발자의 플러그인을 포함해 유료일 수 있습니다. 유료 여부와 받는 방법은 각 플러그인의 설명을 따릅니다.</string>
    <string name="welcome_respect_title">오픈 소스 라이선스 및 저작자 표시</string>
    <string name="welcome_respect_body">이 프로젝트는 GPL-3.0 라이선스의 오픈 소스입니다. 코드를 공부하고 수정하고 공유할 수 있지만, 다음을 지켜야 합니다:\n• 원작자 표기와 라이선스를 유지할 것\n• 수정본에는 ‘수정됨, 비공식 버전’이라고 분명히 표시할 것\n• 원작자나 이 프로젝트의 이름으로 수정본을 배포하거나 홍보하지 말 것</string>
    <string name="welcome_disclaimer_title">면책 및 개인정보</string>
    <string name="welcome_disclaimer_body">이 모듈은 ‘있는 그대로’ 제공되며 어떠한 보증도 하지 않습니다. 사용으로 인한 시스템 문제나 데이터 손실은 사용자 본인의 책임입니다.\n\n이 모듈은 어떠한 개인정보도 수집하지 않습니다. 업데이트를 확인하거나 글꼴·아이콘·플러그인을 내려받거나 감사의 벽을 열 때만 인터넷에 연결합니다.</string>
    <string name="welcome_translation_note">번역은 참고용이며, 내용이 다를 경우 간체 중국어판이 우선합니다. 라이선스 조건은 GPL-3.0 원문을 따릅니다.</string>
    <string name="welcome_confirm_title">내용 확인</string>
    <string name="welcome_confirm_type">아래 문장을 문장 부호까지 직접 입력하세요:</string>
    <string name="welcome_free_phrase">이 모듈은 영구 무료입니다. 기부는 자율입니다. 돈을 주고 사지 마세요.</string>
    <string name="welcome_confirm_hint">여기에 직접 입력</string>
    <string name="welcome_confirm_no_paste">이 입력란은 복사, 붙여넣기, 끌어다 놓기를 지원하지 않습니다.</string>
    <string name="welcome_confirm_mismatch">위 문장을 문장 부호까지 모두 입력하세요.</string>
    <string name="welcome_confirm_required">먼저 아래 확인을 완료해 주세요.</string>
    <string name="welcome_confirm_matched">정확히 입력했습니다. 이제 시작할 수 있습니다.</string>
    <string name="welcome_agree">위 내용을 읽었으며 동의합니다</string>
    <string name="welcome_start">시작하기</string>
    <string name="welcome_close">확인</string>
    <string name="welcome_review_note">위 내용을 이미 읽고 확인했습니다.</string>
    <string name="welcome_save_failed">저장하지 못했습니다. 다시 시도하세요.</string>
