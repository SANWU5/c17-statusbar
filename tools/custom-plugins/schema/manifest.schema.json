{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c17:plugin-manifest:1",
  "title": "C17 API 1/2 ZIP plugin.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "versionCode",
    "apiVersion",
    "entry"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "versionCode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "apiVersion": {
      "enum": [
        1,
        2
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "capabilities": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "settings",
          "systemui",
          "runtime"
        ]
      }
    },
    "entry": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:])(?!.*//).+\\.js$"
    },
    "configurationAliases": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!(?:constructor|prototype)$)[a-zA-Z][a-zA-Z0-9_.-]{0,63}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?!(?:constructor|prototype)$)[a-zA-Z][a-zA-Z0-9_.-]{0,63}(?![\\s\\S])"
      }
    },
    "minimumHost": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "features": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
      }
    },
    "usage": {
      "type": "string",
      "maxLength": 4096
    },
    "scopes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:android|[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)+)$",
        "maxLength": 240
      }
    },
    "nativeSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dex",
        "className"
      ],
      "properties": {
        "dex": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[a-zA-Z0-9_./-]+\\.(?:dex|jar)$"
        },
        "className": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*(?:\\.[a-zA-Z_$][a-zA-Z0-9_$]*)+$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:])(?!.*//).+\\.js$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "preferences": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{2,119}$"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "entry"
          ],
          "not": {
            "required": [
              "source"
            ]
          }
        },
        {
          "required": [
            "source"
          ],
          "not": {
            "required": [
              "entry"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"required": ["configurationAliases"]},
      "then": {
        "required": ["minimumHost", "features"],
        "properties": {
          "apiVersion": {"const": 2},
          "minimumHost": {"minimum": 265},
          "features": {"contains": {"const": "config.aliases"}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "apiVersion": {
            "const": 1
          }
        },
        "required": [
          "apiVersion"
        ]
      },
      "then": {
        "properties": {
          "entry": {
            "maxLength": 128
          },
          "capabilities": {
            "maxItems": 2,
            "items": {
              "enum": [
                "settings",
                "systemui"
              ]
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "runtime"
              ]
            },
            {
              "required": [
                "nativeSettings"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "apiVersion": {
            "const": 2
          }
        },
        "required": [
          "apiVersion"
        ]
      },
      "then": {
        "required": [
          "runtime",
          "capabilities"
        ],
        "properties": {
          "capabilities": {
            "contains": {
              "const": "runtime"
            }
          }
        }
      }
    }
  ],
  "$comment": "API 1/2 结构契约；统一详情页以宿主 code261 为基线。跨控件引用、排序 JSON 内容、字段类型关联与运行能力由 pack.py 和真实宿主共同核验。minimumHost 是展示说明，features 是宿主能力准入。"
}
